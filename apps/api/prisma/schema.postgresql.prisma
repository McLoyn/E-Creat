// ==============================================================================
// Ekraf HUB — Prisma Schema for Supabase PostgreSQL (Production Target)
// Synchronized with docs/supabase_schema.sql
// ==============================================================================

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  USER
  ADMIN
}

enum ContentStatus {
  DRAFT
  PENDING_REVIEW
  NEEDS_REVISION
  REJECTED
  PUBLISHED
  ARCHIVED
}

enum CategoryKind {
  SUBSECTOR
  SUBAPP_TYPE
  WORK_CATEGORY
  PRODUCT_TYPE
}

enum ProductAvailability {
  AVAILABLE
  MADE_TO_ORDER
  UNAVAILABLE
}

model User {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String        @unique
  passwordHash String
  role         Role          @default(USER)
  isActive     Boolean       @default(true)
  lastLoginAt  DateTime?     @db.Timestamptz
  createdAt    DateTime      @default(now()) @db.Timestamptz
  updatedAt    DateTime      @default(now()) @updatedAt @db.Timestamptz

  profile       UserProfile?
  sessions      AuthSession[]
  ownedProfile  CreativeProfileOwner?

  // Audit Relations
  createdCategories Category[]        @relation("CategoryCreatedBy")
  updatedCategories Category[]        @relation("CategoryUpdatedBy")
  createdSubApps    SubApp[]          @relation("SubAppCreatedBy")
  updatedSubApps    SubApp[]          @relation("SubAppUpdatedBy")
  createdProfiles   CreativeProfile[] @relation("ProfileCreatedBy")
  updatedProfiles   CreativeProfile[] @relation("ProfileUpdatedBy")
  assignedOwners    CreativeProfileOwner[] @relation("OwnerAssignedBy")
  reviewedWorks     CreativeWork[]    @relation("WorkReviewedBy")
  createdWorks      CreativeWork[]    @relation("WorkCreatedBy")
  updatedWorks      CreativeWork[]    @relation("WorkUpdatedBy")
  reviewedProducts  CreativeProduct[] @relation("ProductReviewedBy")
  createdProducts   CreativeProduct[] @relation("ProductCreatedBy")
  updatedProducts   CreativeProduct[] @relation("ProductUpdatedBy")
}

model UserProfile {
  id           String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String                @unique @db.Uuid
  displayName  String
  locationText String?
  photoPath    String?
  bio          String?               @db.VarChar(500)
  createdAt    DateTime              @default(now()) @db.Timestamptz
  updatedAt    DateTime              @default(now()) @updatedAt @db.Timestamptz

  user         User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  interests    UserProfileInterest[]
}

model UserProfileInterest {
  userProfileId String      @db.Uuid
  categoryId    String      @db.Uuid
  createdAt     DateTime    @default(now()) @db.Timestamptz

  profile       UserProfile @relation(fields: [userProfileId], references: [id], onDelete: Cascade)
  category      Category    @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@id([userProfileId, categoryId])
}

model AuthSession {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId              String    @db.Uuid
  familyId            String    @db.Uuid
  refreshTokenHash    String    @unique
  expiresAt           DateTime  @db.Timestamptz
  revokedAt           DateTime? @db.Timestamptz
  replacedBySessionId String?   @db.Uuid
  userAgent           String?
  createdAt           DateTime  @default(now()) @db.Timestamptz

  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "idx_session_user")
  @@index([familyId], map: "idx_session_family")
  @@index([expiresAt], map: "idx_session_expires")
}

model Category {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  kind        CategoryKind
  name        String
  slug        String
  description String?
  isActive    Boolean      @default(true)
  sortOrder   Int          @default(0)
  createdById String?      @db.Uuid
  updatedById String?      @db.Uuid
  createdAt   DateTime     @default(now()) @db.Timestamptz
  updatedAt   DateTime     @default(now()) @updatedAt @db.Timestamptz

  createdBy   User?        @relation("CategoryCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy   User?        @relation("CategoryUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  subApps          SubAppCategory[]
  creativeProfiles CreativeProfileCategory[]
  userInterests    UserProfileInterest[]
  works            CreativeWork[]
  products         CreativeProduct[]

  @@unique([kind, slug], map: "uq_category_kind_slug")
  @@unique([kind, name], map: "uq_category_kind_name")
  @@index([kind, isActive, sortOrder], map: "idx_category_lookup")
}

model SubApp {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  slug        String        @unique
  tagline     String
  description String
  externalUrl String
  imagePath   String?
  status      ContentStatus @default(DRAFT)
  publishedAt DateTime?     @db.Timestamptz
  archivedAt  DateTime?     @db.Timestamptz
  createdById String?       @db.Uuid
  updatedById String?       @db.Uuid
  createdAt   DateTime      @default(now()) @db.Timestamptz
  updatedAt   DateTime      @default(now()) @updatedAt @db.Timestamptz

  createdBy   User?         @relation("SubAppCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy   User?         @relation("SubAppUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  categories  SubAppCategory[]

  @@index([status, publishedAt(sort: Desc)], map: "idx_subapp_status_published")
  @@index([status, name], map: "idx_subapp_status_name")
}

model SubAppCategory {
  subAppId   String   @db.Uuid
  categoryId String   @db.Uuid

  subApp     SubApp   @relation(fields: [subAppId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@id([subAppId, categoryId])
  @@index([categoryId], map: "idx_subapp_category")
}

model CreativeProfile {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name            String
  slug            String        @unique
  summary         String
  description     String
  city            String
  district        String?
  imagePath       String?
  websiteUrl      String?
  instagramHandle String?
  whatsappNumber  String?
  status          ContentStatus @default(DRAFT)
  publishedAt     DateTime?     @db.Timestamptz
  archivedAt      DateTime?     @db.Timestamptz
  createdById     String?       @db.Uuid
  updatedById     String?       @db.Uuid
  createdAt       DateTime      @default(now()) @db.Timestamptz
  updatedAt       DateTime      @default(now()) @updatedAt @db.Timestamptz

  createdBy       User?         @relation("ProfileCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy       User?         @relation("ProfileUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  categories      CreativeProfileCategory[]
  owner           CreativeProfileOwner?
  works           CreativeWork[]
  products        CreativeProduct[]

  @@index([status, publishedAt(sort: Desc)], map: "idx_creative_status_published")
  @@index([status, city], map: "idx_creative_status_city")
  @@index([status, district], map: "idx_creative_status_district")
}

model CreativeProfileCategory {
  creativeProfileId String          @db.Uuid
  categoryId        String          @db.Uuid

  creativeProfile   CreativeProfile @relation(fields: [creativeProfileId], references: [id], onDelete: Cascade)
  category          Category        @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@id([creativeProfileId, categoryId])
  @@index([categoryId], map: "idx_creative_category")
}

model CreativeProfileOwner {
  id                String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  creativeProfileId String          @unique @db.Uuid
  userId            String          @unique @db.Uuid
  assignedById      String?         @db.Uuid
  createdAt         DateTime        @default(now()) @db.Timestamptz

  creativeProfile   CreativeProfile @relation(fields: [creativeProfileId], references: [id], onDelete: Cascade)
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedBy        User?           @relation("OwnerAssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)
}

model CreativeWork {
  id                String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  creativeProfileId String          @db.Uuid
  title             String
  slug              String          @unique
  description       String
  imagePaths        String          @default("[]")
  technique         String?
  motif             String?
  year              Int?
  categoryId        String?         @db.Uuid
  status            ContentStatus   @default(DRAFT)
  reviewNote        String?
  submittedAt       DateTime?       @db.Timestamptz
  reviewedAt        DateTime?       @db.Timestamptz
  reviewedById      String?         @db.Uuid
  publishedAt       DateTime?       @db.Timestamptz
  archivedAt        DateTime?       @db.Timestamptz
  createdById       String?         @db.Uuid
  updatedById       String?         @db.Uuid
  createdAt         DateTime        @default(now()) @db.Timestamptz
  updatedAt         DateTime        @default(now()) @updatedAt @db.Timestamptz

  creativeProfile   CreativeProfile @relation(fields: [creativeProfileId], references: [id], onDelete: Restrict)
  category          Category?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  reviewedBy        User?           @relation("WorkReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  createdBy         User?           @relation("WorkCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy         User?           @relation("WorkUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  products          CreativeProduct[]

  @@index([status, publishedAt(sort: Desc)], map: "idx_work_status_published")
  @@index([creativeProfileId, status], map: "idx_work_creator_status")
  @@index([categoryId], map: "idx_work_category")
}

model CreativeProduct {
  id                String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  creativeProfileId String              @db.Uuid
  workId            String?             @db.Uuid
  title             String
  slug              String              @unique
  description       String
  imagePaths        String              @default("[]")
  productTypeId     String              @db.Uuid
  material          String?
  dimensions        String?
  priceMin          Int?
  priceMax          Int?
  priceUnit         String?             @db.VarChar(30)
  availability      ProductAvailability @default(AVAILABLE)
  status            ContentStatus       @default(DRAFT)
  reviewNote        String?
  submittedAt       DateTime?           @db.Timestamptz
  reviewedAt        DateTime?           @db.Timestamptz
  reviewedById      String?             @db.Uuid
  publishedAt       DateTime?           @db.Timestamptz
  archivedAt        DateTime?           @db.Timestamptz
  createdById       String?             @db.Uuid
  updatedById       String?             @db.Uuid
  createdAt         DateTime            @default(now()) @db.Timestamptz
  updatedAt         DateTime            @default(now()) @updatedAt @db.Timestamptz

  creativeProfile   CreativeProfile     @relation(fields: [creativeProfileId], references: [id], onDelete: Restrict)
  productType       Category            @relation(fields: [productTypeId], references: [id], onDelete: Restrict)
  work              CreativeWork?       @relation(fields: [workId], references: [id], onDelete: SetNull)
  reviewedBy        User?               @relation("ProductReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  createdBy         User?               @relation("ProductCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy         User?               @relation("ProductUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([status, publishedAt(sort: Desc)], map: "idx_prod_status_published")
  @@index([creativeProfileId, status], map: "idx_prod_creator_status")
  @@index([productTypeId], map: "idx_prod_type")
}
