{
  "name": "ekraf-hub",
  "version": "0.1.0",
  "private": true,
  "description": "Ekraf HUB V0.1 — Platform Ekosistem Ekonomi Kreatif Tuban",
  "scripts": {
    "dev": "npx tsx apps/api/src/server.ts",
    "start": "npx tsx apps/api/src/server.ts",
    "dev:api": "pnpm --filter @ekraf/api dev",
    "dev:web": "pnpm --filter @ekraf/web dev",
    "build": "pnpm --filter \"@ekraf/*\" build",
    "db:migrate": "pnpm --filter @ekraf/api db:migrate",
    "db:seed": "pnpm --filter @ekraf/api db:seed"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "prisma"
    ]
  },
  "devDependencies": {
    "typescript": "^5.7.2"
  }
}
